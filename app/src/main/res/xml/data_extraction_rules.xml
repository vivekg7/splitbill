<?xml version="1.0" encoding="utf-8"?>
<!-- Device-to-device transfer (new phone setup) may copy the database; cloud backup may
     not, because the app promises that nothing leaves the phone unless the user sends it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
    </device-transfer>
</data-extraction-rules>
